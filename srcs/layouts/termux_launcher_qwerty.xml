<?xml version="1.0" encoding="utf-8"?>
<!--
  QWERTY ("Termux Launcher") layout, imported from termux-launcher for use as a
  terminal-friendly text layout in the standalone IME.

  Differs from latn_qwerty_us:
  - Own bottom row (bottom_row="false") with terminal-oriented swipe slots.
  - Fn is a real layer: top row -> F1-F12, home row -> navigation, n/m -> ^C/^D.
  - Corner symbols favour shell punctuation.

  Launcher-only `tool:` actions (command palette / window / session / dictate)
  from the original are intentionally dropped here; a standalone IME has no
  launcher to command. Voice dictation keeps its `loc voice_typing` binding.
-->
<keyboard bottom_row="false" name="QWERTY (Termux Launcher)" script="latin">
  <row>
    <key c="q" ne="1" se="loc esc"/>
    <key c="w" nw="~" ne="2" sw="\@"/>
    <key c="e" nw="!" ne="3" sw="\#" se="loc €"/>
    <key c="r" ne="4" sw="$"/>
    <key c="t" ne="5" sw="%"/>
    <key c="y" split_before="true" ne="6" sw="^"/>
    <key c="u" ne="7" sw="&amp;"/>
    <key c="i" ne="8" sw="*"/>
    <key c="o" ne="9" sw="(" se=")"/>
    <key c="p" ne="0"/>
  </row>
  <row>
    <key shift="0.5" c="a" nw="loc tab" ne="`"/>
    <key c="s" ne="loc §" sw="loc ß"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g" ne="-" sw="_"/>
    <key c="h" split_before="true" ne="=" sw="+"/>
    <key c="j" sw="{" se="}"/>
    <key c="k" sw="[" se="]"/>
    <key c="l" ne="|" sw="\\"/>
  </row>
  <row>
    <key width="1.5" role="action" c="shift" ne="loc capslock"/>
    <key c="z"/>
    <key c="x" ne="loc †"/>
    <key c="c" ne="&lt;" sw="."/>
    <key c="v" ne=">" sw=","/>
    <key c="b" split_before="true" ne="\?" sw="/"/>
    <key c="n" ne=":" sw=";"/>
    <key c="m" ne="&quot;" sw="'"/>
    <key width="1.5" role="action" c="backspace" ne="delete"/>
  </row>
  <row height="0.95">
    <key width="1.7" role="action" c="ctrl" ne="loc switch_clipboard" sw="loc meta" se="switch_numeric"/>
    <key width="1.3" role="action" c="loc alt" nw="fn" ne="loc change_method" se="config"/>
    <key width="4.0" role="space_bar" c="space" split_at="2.5" w="cursor_left" e="cursor_right" s="switch_backward"/>
    <key width="1.3" role="action" c="loc compose" nw="home" ne="page_up" sw="page_down" se="end" w="left" e="right" n="up" s="down"/>
    <key width="1.7" role="action" c="enter" n="loc voice_typing" s="floating"/>
  </row>
  <modmap>
    <fn a="q" b="f1"/>
    <fn a="w" b="f2"/>
    <fn a="e" b="f3"/>
    <fn a="r" b="f4"/>
    <fn a="t" b="f5"/>
    <fn a="y" b="f6"/>
    <fn a="u" b="f7"/>
    <fn a="i" b="f8"/>
    <fn a="o" b="f9"/>
    <fn a="p" b="f10"/>
    <fn a="a" b="esc"/>
    <fn a="s" b="tab"/>
    <fn a="d" b="home"/>
    <fn a="f" b="up"/>
    <fn a="g" b="end"/>
    <fn a="h" b="page_up"/>
    <fn a="j" b="left"/>
    <fn a="k" b="down"/>
    <fn a="l" b="right"/>
    <fn a="z" b="f11"/>
    <fn a="x" b="f12"/>
    <fn a="c" b="insert"/>
    <fn a="v" b="delete"/>
    <fn a="b" b="page_down"/>
    <fn a="n" b="^C:ctrl,c"/>
    <fn a="m" b="^D:ctrl,d"/>
  </modmap>
</keyboard>